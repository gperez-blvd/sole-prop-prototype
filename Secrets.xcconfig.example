// Copy this file to Secrets.xcconfig (gitignored) and fill in your real key.
// Secrets.xcconfig is read by project.yml as a build setting, then handed
// to the app at launch as the ELEVENLABS_API_KEY environment variable.
// Because it's a separate gitignored file, it survives `xcodegen generate`
// — unlike the scheme's environment variables, which reset every regen.
ELEVENLABS_API_KEY =
